# Copy to `.env` and fill in. `.env` is gitignored — never commit real keys.
# Nothing in this file is safe to expose to the client except the EXPO_PUBLIC_* vars.

# --- OpenAI: Whisper STT + chat + TTS fallback -------------------------------
# https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# --- ElevenLabs: primary TTS -------------------------------------------------
# https://elevenlabs.io/app/settings/api-keys
# Leave blank to force the OpenAI TTS fallback.
ELEVENLABS_API_KEY=
# Voice ID for Ammamma. Pick after auditioning voices on Telugu — see spike/README.md
ELEVENLABS_VOICE_ID=

# --- Supabase ----------------------------------------------------------------
# Project settings -> API. The service role key bypasses RLS: server-side only, NEVER in the app.
SUPABASE_URL=https://urtskmrdjeuippdozgeb.supabase.co/rest/v1/
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=postgresql://postgres:[password]@db.your-project.supabase.co:5432/postgres

# --- Client-visible (bundled into the app — anon key is safe, it is RLS-gated) ---
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=
