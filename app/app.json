{
  "expo": {
    "name": "Ammamma",
    "slug": "ammamma",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "ammamma",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FDF6EC"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.ammamma.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Ammamma needs your microphone so she can hear you speak Telugu.",
        "NSLocalNetworkUsageDescription": "Ammamma connects to the development server on your local network.",
        "NSBonjourServices": [
          "_http._tcp"
        ]
      }
    },
    "android": {
      "package": "com.ammamma.app",
      "predictiveBackGestureEnabled": false,
      "adaptiveIcon": {
        "backgroundColor": "#FDF6EC",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-audio"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
